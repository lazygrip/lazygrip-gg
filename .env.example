# Copy this to .env.local and fill in your values
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Shared secret gating the operator-only /api/admin/sequence-thread route (unset = the route answers 503 and does nothing)
LAZYGRIP_ADMIN_TASK_SECRET=

# Optional. Discord bot token, used for one thing only: renaming and retagging an EXISTING forum thread when a published sequence changes (unset = that sync is skipped and nothing else behaves differently)
# A webhook cannot do this - thread_name and applied_tags are honoured only on the post that creates a thread - so it needs the bot's own credential
# The bot needs MANAGE_THREADS in the guild holding the sequence forum
DISCORD_BOT_TOKEN=
