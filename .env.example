# Copy this to .env.local and fill in your values.
#
# This file documents EVERY environment variable the code reads. The list was
# generated rather than remembered:
#
#     git grep -oh "process\.env\.[A-Za-z0-9_]*" -- src scripts next.config.js | sort -u
#
# which returns exactly the 13 names below. Audit M11 was that it documented 4
# of them, and the two it called security-critical -- SUPABASE_SERVICE_ROLE_KEY
# and CRON_SECRET -- were both absent, so a new deploy could come up looking
# configured while the cron routes and every admin-client write silently did
# nothing. Re-run that grep when adding one; a variable the code reads and this
# file does not name is the defect, not the other way round.
#
# Nothing here is a secret. Values are placeholders.

# ---------------------------------------------------------------------------
# REQUIRED -- the app does not function without these
# ---------------------------------------------------------------------------

# Supabase project URL and publishable (anon) key. Both are NEXT_PUBLIC_, so
# both ship in the browser bundle by design -- the anon key is not a secret and
# is safe there. It is RLS and the column grants (migrations 031, 032) that
# stand between it and your data, which is exactly why those migrations matter.
# Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------------
# SECRETS -- server-only. Never prefix any of these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# The service-role key. BYPASSES ROW LEVEL SECURITY ENTIRELY. Used by
# createAdminClient() for the routes that have to act outside a user session
# (Discord relay, notify-discord, the admin thread tasks). Anyone holding this
# holds the whole database. Settings > API, "service_role".
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the scheduled routes under /api/cron/*. The routes FAIL
# CLOSED: unset means every cron request is rejected rather than allowed, so
# leaving this blank disables the patch reminder rather than exposing it.
# Vercel sends it as `Authorization: Bearer <value>`.
CRON_SECRET=

# Shared secret the Discord relay signs its callbacks with, verified on
# /api/relay/*. Unset means the relay routes reject everything.
DISCORD_RELAY_SECRET=

# Shared secret gating the operator-only /api/admin/sequence-thread route
# (unset = the route answers 503 and does nothing).
LAZYGRIP_ADMIN_TASK_SECRET=

# Shared secret for the author-lock administrative path.
LAZYGRIP_AUTHOR_LOCK_SECRET=

# ---------------------------------------------------------------------------
# DISCORD INTEGRATION -- optional. Each unset value disables its own feature
# and nothing else.
# ---------------------------------------------------------------------------

# Webhook that posts a forum thread when a sequence is published.
DISCORD_WEBHOOK_URL=

# Webhook the patch-reminder cron posts to. Separate from the one above so a
# reminder cannot land in the sequence forum.
DISCORD_PATCH_REMINDER_WEBHOOK_URL=

# Discord bot token, used for one thing only: renaming and retagging an EXISTING
# forum thread when a published sequence changes (unset = that sync is skipped
# and nothing else behaves differently). A webhook cannot do this -- thread_name
# and applied_tags are honoured only on the post that CREATES a thread -- so it
# needs the bot's own credential. The bot needs MANAGE_THREADS in the guild
# holding the sequence forum.
DISCORD_BOT_TOKEN=

# ---------------------------------------------------------------------------
# BUILD-TIME ONLY -- read by scripts/, not by the running app. Leave unset for
# a normal build; the generated catalog is committed.
# ---------------------------------------------------------------------------

# Inline JSON for the spell catalog, or a path to it on disk. Consumed by
# `npm run generate:spell-catalog`. SPELL_CATALOG_JSON wins if both are set.
SPELL_CATALOG_JSON=
SPELL_CATALOG_PATH=

# Local checkout of the GRIP-EMS addon, used by the same generator to read spell
# data straight out of the addon rather than from a catalog file.
GRIP_EMS_ADDON_DIR=
